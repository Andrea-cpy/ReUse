@* Muestra una calificación de 0 a 5 con estrellas *@

<span class="ru-estrellas" title="@Valor.ToString("0.0") de 5">
    @for (int i = 1; i <= 5; i++)
    {
        if (Valor >= i)
        {
            <i class="bi bi-star-fill"></i>
        }
        else if (Valor >= i - 0.5)
        {
            <i class="bi bi-star-half"></i>
        }
        else
        {
            <i class="bi bi-star"></i>
        }
    }
</span>
@if (MostrarNumero)
{
    <span class="ms-1 fw-semibold">@Valor.ToString("0.0")</span>
}

@code {
    [Parameter] public double Valor { get; set; }
    [Parameter] public bool MostrarNumero { get; set; }
}
