@inject IInsigniaService InsigniaService

@* RF-18: nivel de reputación (GET /usuarios/{id}/reputacion) e insignias obtenidas (GET /usuarios/{id}/insignias).
   Con PermitirEvaluar, el dueño del perfil puede pedir que se evalúen sus reglas (POST /usuarios/{id}/insignias/evaluar). *@

<div class="ru-card ru-card-body h-100">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h3 mb-0"><i class="bi bi-award me-1"></i> Reputación e insignias</h2>
        @if (reputacion is not null)
        {
            <span class="badge rounded-pill @ClaseNivel(reputacion.Nivel)"><i class="bi bi-gem me-1"></i>Nivel @Formato.Texto(reputacion.Nivel)</span>
        }
    </div>

    @if (cargando)
    {
        <Cargando />
    }
    else
    {
        @if (!string.IsNullOrEmpty(mensaje))
        {
            <div class="alert alert-success small py-2">@mensaje</div>
        }
        @if (reputacion is not null)
        {
            <div class="row g-2 text-center mb-3 small">
                <div class="col-4"><div class="border rounded p-2"><div class="fw-bold fs-5">@reputacion.VentasCompletadas</div>Ventas</div></div>
                <div class="col-4"><div class="border rounded p-2"><div class="fw-bold fs-5">@reputacion.ComprasCompletadas</div>Compras</div></div>
                <div class="col-4"><div class="border rounded p-2"><div class="fw-bold fs-5">@reputacion.CalificacionPromedio.ToString("0.0")</div>Promedio</div></div>
            </div>
        }

        @if (insignias.Any())
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (InsigniaUsuarioDTO i in insignias)
                {
                    <div class="d-flex align-items-center gap-2 border rounded-pill pe-3 ps-1 py-1" title="@i.Descripcion">
                        <span class="ru-avatar sm" style="background:#fdf3dc;color:#a87612">
                            @if (EsUrl(i.Icono))
                            {
                                <img src="@i.Icono" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:50%" onerror="this.style.display='none'" />
                            }
                            else
                            {
                                <i class="bi @IconoDe(i)"></i>
                            }
                        </span>
                        <span class="small">
                            <span class="fw-semibold d-block lh-sm">@i.Nombre</span>
                            <span class="small-muted" style="font-size:.7rem">@Formato.Texto(i.Tipo) · @Formato.Fecha(i.FechaObtencion)</span>
                        </span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="small-muted">Aún no tiene insignias. Se obtienen al completar ventas y compras con buenas calificaciones.</div>
        }

        @if (PermitirEvaluar)
        {
            <button class="btn btn-light btn-sm mt-3" disabled="@evaluando" @onclick="Evaluar">
                <i class="bi bi-arrow-repeat me-1"></i> Revisar si gané insignias nuevas
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public int IdUsuario { get; set; }
    [Parameter] public bool PermitirEvaluar { get; set; }

    private ReputacionDTO? reputacion;
    private List<InsigniaUsuarioDTO> insignias = [];
    private bool cargando = true;
    private bool evaluando;
    private string? mensaje;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        try
        {
            // En paralelo: cada llamada consulta la BD por separado.
            Task<ReputacionDTO?> tareaReputacion = InsigniaService.Reputacion(IdUsuario);
            Task<List<InsigniaUsuarioDTO>> tareaInsignias = InsigniaService.DeUsuario(IdUsuario);
            reputacion = await tareaReputacion;
            insignias = await tareaInsignias;
        }
        catch (ServicioException)
        {
            // Si el backend no responde, el resto del perfil se sigue mostrando.
        }
        cargando = false;
    }

    private async Task Evaluar()
    {
        evaluando = true;
        try
        {
            EvaluacionInsigniasDTO resultado = await InsigniaService.Evaluar(IdUsuario);
            insignias = resultado.Insignias;
            mensaje = resultado.Nuevas.Any()
                ? $"¡Obtuviste: {string.Join(", ", resultado.Nuevas)}!"
                : "Por ahora no hay insignias nuevas. ¡Sigue completando transacciones!";
        }
        catch (ServicioException ex)
        {
            mensaje = ex.Message;
        }
        evaluando = false;
    }

    private static bool EsUrl(string? icono) => icono is not null && icono.StartsWith("http", StringComparison.OrdinalIgnoreCase);

    private static string IconoDe(InsigniaUsuarioDTO i) =>
        i.Icono is not null && i.Icono.StartsWith("bi-") ? i.Icono : i.Tipo switch
        {
            "VENDEDOR" => "bi-shop",
            "COMPRADOR" => "bi-bag-check",
            _ => "bi-award"
        };

    private static string ClaseNivel(string? nivel) => nivel switch
    {
        "EXPERTO" => "text-bg-dark",
        "DESTACADO" => "text-bg-warning",
        "CONFIABLE" => "text-bg-success",
        _ => "text-bg-light border"
    };
}
