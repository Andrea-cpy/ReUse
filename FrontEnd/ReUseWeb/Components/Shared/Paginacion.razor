@* Paginación visual (sin consulta real) *@

<nav aria-label="Paginación" class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
    <span class="small-muted">Mostrando @Mostrados de @Total resultados</span>
    <ul class="pagination pagination-sm mb-0">
        <li class="page-item @(pagina == 1 ? "disabled" : "")">
            <button class="page-link" @onclick="() => pagina = Math.Max(1, pagina - 1)">Anterior</button>
        </li>
        @for (int i = 1; i <= Paginas; i++)
        {
            int numero = i;
            <li class="page-item @(pagina == numero ? "active" : "")">
                <button class="page-link" @onclick="() => pagina = numero">@numero</button>
            </li>
        }
        <li class="page-item @(pagina == Paginas ? "disabled" : "")">
            <button class="page-link" @onclick="() => pagina = Math.Min(Paginas, pagina + 1)">Siguiente</button>
        </li>
    </ul>
</nav>

@code {
    [Parameter] public int Mostrados { get; set; }
    [Parameter] public int Total { get; set; }
    [Parameter] public int Paginas { get; set; } = 3;

    private int pagina = 1;
}
