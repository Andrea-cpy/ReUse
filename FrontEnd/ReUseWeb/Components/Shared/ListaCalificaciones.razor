@* Calificaciones recibidas por un usuario *@

<div class="ru-card ru-card-body h-100">
    <h2 class="h3 mb-3"><i class="bi bi-star me-1"></i> Calificaciones recibidas</h2>
    @foreach (var c in DatosDemo.Calificaciones)
    {
        <div class="border-bottom pb-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="ru-avatar sm">@DatosDemo.Iniciales(c.Autor)</span>
                    <span class="fw-semibold small">@c.Autor</span>
                </div>
                <Estrellas Valor="c.Puntaje" />
            </div>
            <p class="small mb-1 mt-2">@c.Comentario</p>
            <div class="small-muted" style="font-size:.75rem">
                @(c.Tipo == "COMPRADOR_A_VENDEDOR" ? "Como vendedor" : "Como comprador") · @c.Fecha
            </div>
        </div>
    }
    <button class="btn btn-light btn-sm w-100">Ver todas</button>
</div>
