@inject ICalificacionService CalificacionService

@* Calificaciones recibidas por un usuario → GET /calificaciones?calificado=ID (RF-15 / RF-18) *@

<div class="ru-card ru-card-body h-100">
    <h2 class="h3 mb-3"><i class="bi bi-star me-1"></i> Calificaciones recibidas</h2>
    @if (cargando)
    {
        <Cargando />
    }
    else if (error is not null)
    {
        <div class="small text-danger">@error</div>
    }
    else if (!calificaciones.Any())
    {
        <div class="small-muted">Aún no tiene calificaciones.</div>
    }
    else
    {
        foreach (CalificacionDTO c in calificaciones.Take(verTodas ? int.MaxValue : 4))
        {
            <div class="border-bottom pb-3 mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center gap-2">
                        <span class="ru-avatar sm">@Formato.Iniciales(c.NombreCalificador)</span>
                        <span class="fw-semibold small">@c.NombreCalificador</span>
                    </div>
                    <Estrellas Valor="c.Puntaje" />
                </div>
                @if (!string.IsNullOrWhiteSpace(c.Comentario))
                {
                    <p class="small mb-1 mt-2">@c.Comentario</p>
                }
                <div class="small-muted" style="font-size:.75rem">
                    @(c.Tipo == "COMPRADOR_A_VENDEDOR" ? "Como vendedor" : "Como comprador") · @Formato.Fecha(c.Fecha)
                </div>
            </div>
        }
        if (calificaciones.Count > 4)
        {
            <button class="btn btn-light btn-sm w-100" @onclick="() => verTodas = !verTodas">
                @(verTodas ? "Ver menos" : $"Ver todas ({calificaciones.Count})")
            </button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public int IdUsuario { get; set; }

    private List<CalificacionDTO> calificaciones = [];
    private bool cargando = true;
    private bool verTodas;
    private string? error;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        try
        {
            calificaciones = await CalificacionService.Recibidas(IdUsuario);
            error = null;
        }
        catch (ServicioException ex)
        {
            error = ex.Message;
        }
        cargando = false;
    }
}
