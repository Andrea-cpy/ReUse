@* Indicador mientras llega la respuesta del servicio web *@

<div class="d-flex align-items-center gap-2 text-secondary p-4">
    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
    <span>@Texto</span>
</div>

@code {
    [Parameter] public string Texto { get; set; } = "Cargando…";
}
