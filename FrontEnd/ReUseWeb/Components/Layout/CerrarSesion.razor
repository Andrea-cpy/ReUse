@* Cierra la sesión con un POST al endpoint /cuenta/logout (borra la cookie) *@

<form method="post" action="cuenta/logout" class="m-0">
    <AntiforgeryToken />
    <button type="submit" class="ru-nav-link border-0 bg-transparent w-100 text-start">
        <i class="bi bi-box-arrow-left"></i> Cerrar sesión
    </button>
</form>
