@page "/login"

@* El formulario se envía con POST a /cuenta/login (SeguridadExtensions). Ese endpoint llama a
   POST /auth/login del backend Java, que valida el hash BCrypt y el estado de la cuenta,
   y crea la cookie de sesión con el rol ESTUDIANTE o ADMINISTRADOR. *@

<PageTitle>Iniciar sesión · ReUse</PageTitle>

<h1 class="mb-1">Iniciar sesión</h1>
<p class="small-muted mb-4">Ingresa con tu correo institucional PUCP. Si eres administrador, usa tu misma cuenta: el sistema reconoce tu rol.</p>

@if (!string.IsNullOrEmpty(Error))
{
    <div class="alert alert-danger d-flex gap-2"><i class="bi bi-exclamation-triangle-fill mt-1"></i><div>@Error</div></div>
}
@if (Registrado)
{
    <div class="alert alert-success d-flex gap-2"><i class="bi bi-check-circle-fill mt-1"></i>
        <div>Cuenta creada. Podrás ingresar cuando un administrador la verifique.</div></div>
}

<form method="post" action="cuenta/login">
    <AntiforgeryToken />
    <div class="mb-3">
        <label class="form-label" for="correo">Correo institucional</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
            <input id="correo" name="correo" type="email" class="form-control" placeholder="@("a20221234@pucp.edu.pe")" required autocomplete="username" />
        </div>
    </div>
    <div class="mb-4">
        <label class="form-label" for="contrasena">Contraseña</label>
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-lock"></i></span>
            <input id="contrasena" name="contrasena" type="@(verContrasena ? "text" : "password")" class="form-control" required autocomplete="current-password" />
            <button type="button" class="btn btn-outline-secondary" title="Mostrar u ocultar" @onclick="() => verContrasena = !verContrasena">
                <i class="bi @(verContrasena ? "bi-eye-slash" : "bi-eye")"></i>
            </button>
        </div>
    </div>
    <button type="submit" class="btn btn-primary w-100 py-2">Ingresar</button>
</form>

<div class="d-flex align-items-center gap-2 my-3 small-muted">
    <hr class="flex-grow-1 m-0" /><span>o</span><hr class="flex-grow-1 m-0" />
</div>

@* Propuesta del equipo para el flujo de verificación: autenticar con la cuenta Google institucional
   (@pucp.edu.pe) mediante OAuth 2.0 / OpenID Connect. Si Google confirma el correo PUCP, la cuenta
   no necesitaría una verificación manual del administrador. En esta entrega solo se muestra el botón. *@
<button type="button" class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center gap-2"
        @onclick="() => avisoGoogle = true">
    <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
    </svg>
    Iniciar sesión con Google
</button>
@if (avisoGoogle)
{
    <div class="alert alert-light border small mt-2 mb-0">
        <i class="bi bi-info-circle me-1"></i>
        Próximamente: ingresarás con tu cuenta Google @@pucp.edu.pe y tu correo quedará verificado automáticamente.
    </div>
}

<p class="text-center small mt-4 mb-0">
    ¿Aún no tienes cuenta? <NavLink href="registro">Regístrate con tu código PUCP</NavLink>
</p>

@code {
    /// <summary>Mensaje de la regla de negocio que rechazó el login (lo envía el endpoint /cuenta/login).</summary>
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public bool Registrado { get; set; }

    private bool verContrasena;
    private bool avisoGoogle;
}
