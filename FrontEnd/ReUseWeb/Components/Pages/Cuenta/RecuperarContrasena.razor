@page "/recuperar-contrasena"
@inherits PaginaBase
@inject IUsuarioService UsuarioService

@* RF-01 (flujo secundario): recuperación de contraseña en dos pasos.
   1) POST /auth/recuperar genera un código de 6 dígitos válido por 15 minutos.
   2) POST /auth/restablecer valida el código y guarda la nueva contraseña (hash BCrypt).
   El proyecto aún no envía correos: el código solo queda en el log del servidor (server.log de GlassFish).
   Nunca se muestra aquí: cualquiera podría cambiar la contraseña de otra cuenta sabiendo su correo. *@

<PageTitle>Recuperar contraseña · ReUse</PageTitle>

<NavLink class="ru-volver" href="login"><i class="bi bi-arrow-left"></i> Volver a iniciar sesión</NavLink>
<h1 class="mb-1">Recuperar contraseña</h1>

@if (listo)
{
    <div class="alert alert-success d-flex gap-2 mt-3"><i class="bi bi-check-circle-fill mt-1"></i>
        <div>Tu contraseña fue actualizada. Ya puedes iniciar sesión con la nueva.</div></div>
    <NavLink class="btn btn-primary w-100 py-2" href="login">Ir a iniciar sesión</NavLink>
}
else if (!codigoEnviado)
{
    <p class="small-muted mb-4">Ingresa tu correo institucional y te enviaremos un código de verificación.</p>
    <Alertas Error="@Error" />
    <EditForm Model="solicitud" OnValidSubmit="Solicitar" FormName="recuperar-correo">
        <DataAnnotationsValidator />
        <p class="ru-nota-requeridos mb-2">Campos obligatorios</p>
        <div class="mb-3">
            <label class="form-label requerido" for="correo">Correo institucional</label>
            <div class="input-group has-validation">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <InputTexto id="correo" type="email" class="form-control" placeholder="@("a20221234@pucp.edu.pe")" autocomplete="username" @bind-Value="solicitud.Correo" />
            </div>
            <ValidationMessage For="() => solicitud.Correo" />
        </div>
        <BotonEnviar Texto="Enviar código" Procesando="@Procesando" Clase="btn-primary w-100 py-2" />
    </EditForm>
}
else
{
    <p class="small-muted mb-3">Si <strong>@solicitud.Correo</strong> está registrado en ReUse, te enviamos un código de 6 dígitos (vence en 15 minutos). Ingrésalo y elige tu nueva contraseña.</p>
    <Alertas Error="@Error" />
    <EditForm Model="cambio" OnValidSubmit="Restablecer" FormName="recuperar-cambio">
        <DataAnnotationsValidator />
        <p class="ru-nota-requeridos mb-2">Campos obligatorios</p>
        <div class="mb-3">
            <label class="form-label requerido" for="codigo">Código de 6 dígitos</label>
            <InputTexto id="codigo" class="form-control text-center fs-5" maxlength="6" inputmode="numeric" autocomplete="one-time-code" @bind-Value="cambio.Codigo" />
            <ValidationMessage For="() => cambio.Codigo" />
        </div>
        <div class="mb-3">
            <label class="form-label requerido" for="nueva">Nueva contraseña</label>
            <InputTexto id="nueva" type="password" class="form-control" autocomplete="new-password" @bind-Value="cambio.Nueva" />
            <div class="form-text">Mínimo 8 caracteres.</div>
            <ValidationMessage For="() => cambio.Nueva" />
        </div>
        <div class="mb-4">
            <label class="form-label requerido" for="repetir">Repite la contraseña</label>
            <InputTexto id="repetir" type="password" class="form-control" autocomplete="new-password" @bind-Value="cambio.Repetir" />
            <ValidationMessage For="() => cambio.Repetir" />
        </div>
        <BotonEnviar Texto="Cambiar contraseña" Procesando="@Procesando" Clase="btn-primary w-100 py-2" />
    </EditForm>
    <button class="btn btn-link w-100 mt-2" disabled="@Procesando" @onclick="Solicitar">Enviar un código nuevo</button>
}

@code {
    private readonly SolicitudModelo solicitud = new();
    private CambioModelo cambio = new();
    private bool codigoEnviado;
    private bool listo;

    private async Task Solicitar()
    {
        // La respuesta es la misma exista o no la cuenta (no revela qué correos están registrados).
        if (await Ejecutar(() => UsuarioService.SolicitarRecuperacion(solicitud.Correo.Trim())))
        {
            codigoEnviado = true;
            cambio = new CambioModelo();
        }
    }

    private async Task Restablecer()
    {
        listo = await Ejecutar(() => UsuarioService.RestablecerContrasena(solicitud.Correo.Trim(), cambio.Codigo.Trim(), cambio.Nueva));
    }

    private class SolicitudModelo
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresa tu correo institucional.")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^[^@\s]+@pucp\.edu\.pe$", ErrorMessage = "Usa tu correo @pucp.edu.pe.")]
        public string Correo { get; set; } = "";
    }

    private class CambioModelo
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresa el código que recibiste.")]
        [System.ComponentModel.DataAnnotations.RegularExpression(@"^\d{6}$", ErrorMessage = "El código tiene 6 dígitos.")]
        public string Codigo { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Ingresa la nueva contraseña.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "La contraseña debe tener al menos 8 caracteres.")]
        public string Nueva { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Repite la contraseña.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Nueva), ErrorMessage = "Las contraseñas no coinciden.")]
        public string Repetir { get; set; } = "";
    }
}
