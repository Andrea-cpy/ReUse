@page "/admin/facultades/nueva"
@page "/admin/facultades/{Id:int}/editar"
@inject NavigationManager Nav

<PageTitle>@(Id.HasValue ? "Editar" : "Nueva") facultad · Admin ReUse</PageTitle>

<EncabezadoPagina Titulo="@(Id.HasValue ? "Editar facultad" : "Nueva facultad")" Volver="admin/facultades" TextoVolver="Volver a facultades" />

<div class="row">
    <div class="col-lg-7">
        <EditForm Model="modelo" OnSubmit="@(() => Nav.NavigateTo("admin/facultades"))" FormName="facultad">
            <div class="ru-card ru-card-body">
                <div class="mb-3">
                    <label class="form-label" for="nombre">Nombre de la facultad</label>
                    <InputText id="nombre" class="form-control" maxlength="120" @bind-Value="modelo.Nombre" />
                </div>
                <div class="form-check form-switch mb-4">
                    <InputCheckbox id="activa" class="form-check-input" role="switch" @bind-Value="modelo.Activa" />
                    <label class="form-check-label" for="activa">Activa</label>
                </div>

                <label class="form-label">Carreras</label>
                <ul class="list-group mb-2">
                    @foreach (var c in modelo.Carreras)
                    {
                        <li class="list-group-item d-flex align-items-center">
                            <span class="flex-grow-1">@c</span>
                            <button type="button" class="btn btn-sm btn-light text-danger" @onclick="() => modelo.Carreras.Remove(c)"><i class="bi bi-x-lg"></i></button>
                        </li>
                    }
                </ul>
                <div class="input-group mb-4">
                    <input class="form-control" placeholder="Nombre de la carrera" @bind="nuevaCarrera" />
                    <button type="button" class="btn btn-outline-primary" @onclick="AgregarCarrera">Agregar</button>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <NavLink class="btn btn-light" href="admin/facultades">Cancelar</NavLink>
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }

    private FacultadModelo modelo = new();
    private string nuevaCarrera = "";

    protected override void OnParametersSet()
    {
        var f = Id.HasValue ? DatosDemo.Facultades.FirstOrDefault(x => x.Id == Id) : null;
        modelo = f is null ? new FacultadModelo() : new FacultadModelo { Nombre = f.Nombre, Activa = f.Activa, Carreras = f.Carreras.ToList() };
    }

    // Solo actualiza la lista en pantalla; no registra nada
    private void AgregarCarrera()
    {
        if (!string.IsNullOrWhiteSpace(nuevaCarrera))
        {
            modelo.Carreras.Add(nuevaCarrera.Trim());
            nuevaCarrera = "";
        }
    }

    private class FacultadModelo
    {
        public string Nombre { get; set; } = "";
        public bool Activa { get; set; } = true;
        public List<string> Carreras { get; set; } = new();
    }
}
