@page "/admin/materiales"

<PageTitle>Materiales académicos · Admin ReUse</PageTitle>

<EncabezadoPagina Titulo="Materiales académicos" Subtitulo="Catálogo de materiales que los estudiantes pueden elegir al publicar.">
    <Acciones>
        <NavLink class="btn btn-primary" href="admin/materiales/nuevo"><i class="bi bi-plus-lg me-1"></i> Nuevo material</NavLink>
    </Acciones>
</EncabezadoPagina>

<div class="ru-card ru-card-body mb-3">
    <div class="row g-2">
        <div class="col-md-6"><input class="form-control" placeholder="Buscar por título" /></div>
        <div class="col-md-4">
            <select class="form-select">
                <option>Todas las categorías</option>
                @foreach (var c in DatosDemo.Categorias.Where(c => c.Activa))
                {
                    <option>@c.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button class="btn btn-primary w-100">Buscar</button></div>
    </div>
</div>

<div class="ru-card">
    <div class="table-responsive">
        <table class="table ru-table">
            <thead>
                <tr><th>Título</th><th>Categoría</th><th>Carreras relacionadas</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var m in DatosDemo.Materiales)
                {
                    <tr>
                        <td class="fw-semibold">@m.Titulo</td>
                        <td>@m.Categoria</td>
                        <td>
                            @if (m.Carreras.Length == 0)
                            {
                                <span class="small-muted">Todas</span>
                            }
                            @foreach (var c in m.Carreras)
                            {
                                <span class="badge text-bg-light border me-1">@c</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <NavLink class="btn btn-light btn-sm" href="@($"admin/materiales/{m.Id}/editar")" title="Editar"><i class="bi bi-pencil"></i></NavLink>
                            <button class="btn btn-light btn-sm text-danger" title="Eliminar" @onclick="() => aEliminar = m"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<ModalConfirmacion Visible="aEliminar is not null" VisibleChanged="@(v => { if (!v) aEliminar = null; })"
                   Titulo="Eliminar material" TextoConfirmar="Eliminar" ClaseBoton="btn-danger"
                   Mensaje="@($"¿Eliminar «{aEliminar?.Titulo}» del catálogo?")" />

@code {
    private MaterialDemo? aEliminar;
}
