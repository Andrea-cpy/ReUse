@page "/anuncios/{Id:int}/ofertar"
@inherits PaginaBase
@inject IAnuncioService AnuncioService
@inject IOfertaService OfertaService
@inject NavigationManager Nav

@* RF-17: el comprador propone un monto → POST /ofertas *@

<PageTitle>Hacer oferta · ReUse</PageTitle>

<EncabezadoPagina Titulo="Hacer una oferta" Subtitulo="Propón un monto al vendedor. Podrá aceptarla, rechazarla o contraofertar."
                  Volver="@($"anuncios/{Id}")" TextoVolver="Volver al anuncio" />

<Alertas Error="@Error" />

@if (anuncio is null)
{
    if (cargado)
    {
        <div class="ru-card"><EstadoVacio Icono="bi-search" Titulo="Anuncio no encontrado" /></div>
    }
    else
    {
        <Cargando />
    }
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="ru-card ru-card-body">
                <p class="ru-nota-requeridos mb-2">Campos obligatorios</p>
                <label class="form-label fw-semibold requerido" for="monto">Monto propuesto</label>
                <div class="input-group input-group-lg has-validation">
                    <span class="input-group-text">S/</span>
                    <input id="monto" type="number" class="form-control @(montoTocado && ErrorMonto is not null ? "is-invalid" : "")"
                           min="0.5" step="0.50" @bind="monto" @bind:event="oninput" @onblur="() => montoTocado = true" />
                </div>
                @if (montoTocado && ErrorMonto is not null)
                {
                    <span class="ru-error-campo">@ErrorMonto</span>
                }
                <div class="mb-2"></div>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    @foreach (int pct in new[] { 100, 95, 90, 85 })
                    {
                        decimal valor = Math.Round(anuncio.Precio * pct / 100m, 2);
                        <button type="button" class="ru-chip" @onclick="() => { monto = valor; montoTocado = true; }">
                            @(pct == 100 ? "Precio publicado" : $"-{100 - pct}%") · @Formato.Soles(valor)
                        </button>
                    }
                </div>

                <div class="alert alert-light border small">
                    <i class="bi bi-info-circle me-1"></i>
                    Si el vendedor acepta tu oferta, se abrirá una transacción y podrán coordinar la cita de entrega.
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <NavLink class="btn btn-light" href="@($"anuncios/{Id}")">Cancelar</NavLink>
                    <div class="text-end">
                        <button type="button" class="btn btn-primary" @onclick="() => confirmar = true" disabled="@(Procesando || ErrorMonto is not null)">
                            <i class="bi bi-send me-1"></i> Enviar oferta
                        </button>
                        @if (ErrorMonto is not null)
                        {
                            <div class="ru-faltantes"><i class="bi bi-info-circle me-1"></i>Para continuar: @ErrorMonto.TrimEnd('.').ToLower()</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="ru-card ru-card-body d-flex gap-3">
                <ImagenMaterial Categoria="@anuncio.NombreCategoria" Url="@anuncio.Imagenes.FirstOrDefault()" Tamano="mini" />
                <div>
                    <div class="fw-semibold">@anuncio.Titulo</div>
                    <div class="small-muted">Vendedor: @anuncio.NombreVendedor</div>
                    <div class="ru-precio mt-1">@Formato.Soles(anuncio.Precio)</div>
                </div>
            </div>
        </div>
    </div>

    <ModalConfirmacion @bind-Visible="confirmar" Titulo="Confirmar oferta" TextoConfirmar="Sí, enviar"
                       Mensaje="@($"Vas a ofrecer {Formato.Soles(monto)} por «{anuncio.Titulo}». ¿Deseas continuar?")"
                       OnConfirmar="Enviar" />
}

@code {
    private bool montoTocado;

    /// <summary>null si el monto es válido; si no, el mensaje que se muestra bajo el campo.</summary>
    private string? ErrorMonto => monto <= 0
        ? "Ingresa un monto mayor que cero."
        : anuncio is not null && monto > anuncio.Precio
            ? $"La oferta no puede superar el precio publicado ({Formato.Soles(anuncio.Precio)})."
            : null;

    [Parameter] public int Id { get; set; }

    private AnuncioDTO? anuncio;
    private decimal monto;
    private bool confirmar;
    private bool cargado;

    protected override async Task OnParametersSetAsync()
    {
        await Ejecutar(async () =>
        {
            anuncio = await AnuncioService.Obtener(Id);
            if (anuncio is not null) monto = anuncio.Precio;
        });
        cargado = true;
    }

    private async Task Enviar()
    {
        int idUsuario = await IdUsuarioAsync();
        // AnuncioBL/OfertaBL validan: anuncio DISPONIBLE, monto > 0 y que no sea tu propio anuncio
        if (await Ejecutar(() => OfertaService.Ofertar(idUsuario, Id, monto)))
        {
            Nav.NavigateTo("mis-ofertas");
        }
    }
}
