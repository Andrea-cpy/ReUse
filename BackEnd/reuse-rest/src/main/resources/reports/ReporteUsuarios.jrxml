<?xml version="1.0" encoding="UTF-8"?>
<!-- RF-13 / RF-18: reputacion y conducta de usuarios (JasperReports 7). Datos: JRBeanCollectionDataSource de FilaUsuario.
     Despues de modificarlo, ejecutar CompilarReportes para regenerar el .jasper. -->
<jasperReport name="ReporteUsuarios" language="java" pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30" topMargin="28" bottomMargin="28"
              whenNoDataType="AllSectionsNoDetail">
	<style name="Base" default="true" fontName="DejaVu Sans" fontSize="8.5" forecolor="#1F2A2E"/>
	<style name="Encabezado" style="Base" mode="Opaque" forecolor="#FFFFFF" backcolor="#1D6B52" bold="true" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"/>
	</style>
	<style name="Celda" style="Base" vTextAlign="Middle">
		<box leftPadding="4" rightPadding="4"/>
	</style>
	<parameter name="TITULO" class="java.lang.String"/>
	<parameter name="FILTROS" class="java.lang.String"/>
	<parameter name="GENERADO_POR" class="java.lang.String"/>
	<parameter name="FECHA_GENERACION" class="java.lang.String"/>
	<parameter name="TOTAL_ACTIVAS" class="java.lang.Integer"/>
	<parameter name="TOTAL_SUSPENDIDAS" class="java.lang.Integer"/>
	<parameter name="TOTAL_PENDIENTES" class="java.lang.Integer"/>
	<parameter name="TOTAL_EN_RIESGO" class="java.lang.Integer"/>
	<field name="codigo" class="java.lang.String"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="carrera" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="reputacionVendedor" class="java.lang.Double"/>
	<field name="reputacionComprador" class="java.lang.Double"/>
	<field name="reportesRecibidos" class="java.lang.Integer"/>
	<field name="sancionesRecientes" class="java.lang.Integer"/>
	<title height="74">
		<element kind="rectangle" x="0" y="0" width="782" height="50" backcolor="#1D6B52" mode="Opaque">
			<pen lineWidth="0.0"/>
		</element>
		<element kind="staticText" x="14" y="6" width="300" height="20" forecolor="#F2C14E" fontSize="15.0" bold="true" style="Base">
			<text><![CDATA[ReUse]]></text>
		</element>
		<element kind="staticText" x="14" y="27" width="420" height="16" forecolor="#E7F3EE" style="Base">
			<text><![CDATA[Marketplace académico PUCP · Programación 3 (1INF30)]]></text>
		</element>
		<element kind="textField" x="380" y="8" width="388" height="20" forecolor="#FFFFFF" fontSize="14.0" bold="true" hTextAlign="Right" style="Base">
			<expression><![CDATA[$P{TITULO}]]></expression>
		</element>
		<element kind="textField" x="380" y="28" width="388" height="16" forecolor="#E7F3EE" hTextAlign="Right" style="Base">
			<expression><![CDATA["Generado el " + $P{FECHA_GENERACION} + " por " + $P{GENERADO_POR}]]></expression>
		</element>
		<element kind="textField" x="0" y="56" width="782" height="14" forecolor="#6B7A80" style="Base">
			<expression><![CDATA[$P{FILTROS}]]></expression>
		</element>
	</title>
	<columnHeader height="20">
		<element kind="staticText" x="0" y="0" width="70" height="20" style="Encabezado"><text><![CDATA[Código]]></text></element>
		<element kind="staticText" x="70" y="0" width="190" height="20" style="Encabezado"><text><![CDATA[Estudiante]]></text></element>
		<element kind="staticText" x="260" y="0" width="160" height="20" style="Encabezado"><text><![CDATA[Carrera]]></text></element>
		<element kind="staticText" x="420" y="0" width="90" height="20" style="Encabezado"><text><![CDATA[Cuenta]]></text></element>
		<element kind="staticText" x="510" y="0" width="70" height="20" hTextAlign="Center" style="Encabezado"><text><![CDATA[Rep. vend.]]></text></element>
		<element kind="staticText" x="580" y="0" width="70" height="20" hTextAlign="Center" style="Encabezado"><text><![CDATA[Rep. comp.]]></text></element>
		<element kind="staticText" x="650" y="0" width="62" height="20" hTextAlign="Center" style="Encabezado"><text><![CDATA[Reportes]]></text></element>
		<element kind="staticText" x="712" y="0" width="70" height="20" hTextAlign="Center" style="Encabezado"><text><![CDATA[Sanciones]]></text></element>
	</columnHeader>
	<detail>
		<band height="20" splitType="Prevent">
			<element kind="rectangle" x="0" y="0" width="782" height="20" mode="Opaque" backcolor="#F5F7F6">
				<printWhenExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></printWhenExpression>
				<pen lineWidth="0.0"/>
			</element>
			<element kind="rectangle" x="0" y="0" width="782" height="20" mode="Opaque" backcolor="#FBE3E1">
				<printWhenExpression><![CDATA[$F{sancionesRecientes} != null && $F{sancionesRecientes} >= 4]]></printWhenExpression>
				<pen lineWidth="0.0"/>
			</element>
			<element kind="textField" x="0" y="0" width="70" height="20" style="Celda"><expression><![CDATA[$F{codigo}]]></expression></element>
			<element kind="textField" x="70" y="0" width="190" height="20" bold="true" textAdjust="ScaleFont" style="Celda"><expression><![CDATA[$F{nombre}]]></expression></element>
			<element kind="textField" x="260" y="0" width="160" height="20" textAdjust="ScaleFont" style="Celda"><expression><![CDATA[$F{carrera}]]></expression></element>
			<element kind="textField" x="420" y="0" width="90" height="20" bold="true" style="Celda"
			         forecolor="#1D6B52"><expression><![CDATA[$F{estado}]]></expression></element>
			<element kind="textField" x="510" y="0" width="70" height="20" hTextAlign="Center" pattern="0.00" style="Celda"><expression><![CDATA[$F{reputacionVendedor}]]></expression></element>
			<element kind="textField" x="580" y="0" width="70" height="20" hTextAlign="Center" pattern="0.00" style="Celda"><expression><![CDATA[$F{reputacionComprador}]]></expression></element>
			<element kind="textField" x="650" y="0" width="62" height="20" hTextAlign="Center" style="Celda"><expression><![CDATA[$F{reportesRecibidos}]]></expression></element>
			<element kind="textField" x="712" y="0" width="70" height="20" hTextAlign="Center" bold="true" style="Celda"><expression><![CDATA[$F{sancionesRecientes} + " / 4"]]></expression></element>
			<element kind="line" x="0" y="19" width="782" height="1">
				<pen lineWidth="0.5" lineColor="#E1E7E4"/>
			</element>
		</band>
	</detail>
	<pageFooter height="20">
		<element kind="staticText" x="0" y="4" width="560" height="14" forecolor="#6B7A80" fontSize="7.5" style="Base">
			<text><![CDATA[ReUse · Reputación de 0 a 5 (promedio de calificaciones). Filas en rojo: 4 o más sanciones en 90 días.]]></text>
		</element>
		<element kind="textField" x="582" y="4" width="160" height="14" forecolor="#6B7A80" fontSize="7.5" hTextAlign="Right" style="Base">
			<expression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></expression>
		</element>
		<element kind="textField" x="742" y="4" width="40" height="14" forecolor="#6B7A80" fontSize="7.5" evaluationTime="Report" style="Base">
			<expression><![CDATA[" " + $V{PAGE_NUMBER}]]></expression>
		</element>
	</pageFooter>
	<summary height="64">
		<element kind="staticText" x="0" y="12" width="200" height="16" fontSize="10.0" bold="true" style="Base">
			<text><![CDATA[Resumen]]></text>
		</element>
		<element kind="textField" x="0" y="32" width="190" height="26" mode="Opaque" backcolor="#E7F3EE" fontSize="9.0" vTextAlign="Middle" style="Base">
			<expression><![CDATA["Cuentas activas: " + $P{TOTAL_ACTIVAS}]]></expression>
			<box leftPadding="8"/>
		</element>
		<element kind="textField" x="198" y="32" width="190" height="26" mode="Opaque" backcolor="#FDF3DC" fontSize="9.0" vTextAlign="Middle" style="Base">
			<expression><![CDATA["Pendientes de verificación: " + $P{TOTAL_PENDIENTES}]]></expression>
			<box leftPadding="8"/>
		</element>
		<element kind="textField" x="396" y="32" width="190" height="26" mode="Opaque" backcolor="#FBE3E1" fontSize="9.0" vTextAlign="Middle" style="Base">
			<expression><![CDATA["Suspendidas: " + $P{TOTAL_SUSPENDIDAS}]]></expression>
			<box leftPadding="8"/>
		</element>
		<element kind="textField" x="594" y="32" width="188" height="26" mode="Opaque" backcolor="#EEF1F2" fontSize="9.0" vTextAlign="Middle" style="Base">
			<expression><![CDATA["En riesgo (2-3 sanciones): " + $P{TOTAL_EN_RIESGO}]]></expression>
			<box leftPadding="8"/>
		</element>
	</summary>
</jasperReport>
